# Copy this file to .streamlit/secrets.toml and paste your keys.
# NEVER upload secrets.toml to GitHub. On Streamlit Community Cloud, paste these
# lines in App settings > Secrets instead.

GEMINI_API_KEY = "paste-your-gemini-key-here"   # https://aistudio.google.com/apikey
GEMINI_MODEL   = "gemini-2.5-flash"

GROQ_API_KEY   = "paste-your-groq-key-here"     # https://console.groq.com/keys (backup)
GROQ_MODEL     = "llama-3.3-70b-versatile"
